{
  "name": "jlp-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "astro": "astro",
    "check": "astro check",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,astro,js,mjs,json,jsonc,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,astro,js,mjs,json,jsonc,md,css}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{tsx,js,mjs,cjs,json,md,css,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "@fontsource-variable/familjen-grotesk": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "clsx": "^2.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwind-merge": "^3.7.0",
    "typescript": "~6",
    "typescript-eslint": "^8.70.0",
    "wrangler": "^4.155.0"
  }
}
