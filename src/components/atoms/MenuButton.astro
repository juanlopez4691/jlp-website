---
import { cn } from "@/libs/utils"

interface Props {
  /** Whether the menu this button controls is open. Swaps the icon. */
  expanded?: boolean
  /** Accessible name, such as "Open menu". */
  label: string
  /** Id of the panel this button controls. */
  controls?: string
  class?: string
}

const { expanded = false, label, controls, class: className } = Astro.props
---

<button
  type="button"
  aria-label={label}
  aria-expanded={expanded}
  aria-controls={controls}
  data-menu-toggle
  class={cn(
    "group size-6 text-navy outline-navy focus-visible:outline-2 focus-visible:outline-offset-4",
    className
  )}
>
  <svg
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
    fill="currentColor"
    class="size-6"
  >
    <g class="group-aria-expanded:hidden">
      <rect x="0" y="4" width="24" height="2"></rect>
      <rect x="0" y="11" width="24" height="2"></rect>
      <rect x="0" y="18" width="24" height="2"></rect>
    </g>
    <g class="hidden group-aria-expanded:block">
      <rect
        x="0"
        y="11"
        width="24"
        height="2"
        transform="rotate(45 12 12)"
      ></rect>
      <rect
        x="0"
        y="11"
        width="24"
        height="2"
        transform="rotate(-45 12 12)"
      ></rect>
    </g>
  </svg>
</button>
