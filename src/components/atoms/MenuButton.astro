---
import type { HTMLAttributes } from "astro/types"
import { cn } from "@/libs/utils"

interface Props extends HTMLAttributes<"button"> {
  /** Whether the menu this button controls is open. Swaps the icon. */
  expanded?: boolean
  /** Accessible name, such as "Open menu". */
  label: string
}

const { expanded = false, label, class: className, ...rest } = Astro.props
---

<button
  {...rest}
  type="button"
  aria-label={label}
  aria-expanded={expanded}
  class={cn(
    "group size-6 text-navy outline-navy focus-visible:outline-2 focus-visible:outline-offset-4",
    className
  )}
>
  <svg
    viewBox="0 0 24 24"
    aria-hidden="true"
    fill="currentColor"
    class="size-6"
  >
    <g class="group-aria-expanded:hidden">
      <rect y="4" width="24" height="2"></rect>
      <rect y="11" width="24" height="2"></rect>
      <rect y="18" width="24" height="2"></rect>
    </g>
    <g class="hidden group-aria-expanded:block">
      <rect y="11" width="24" height="2" transform="rotate(45 12 12)"></rect>
      <rect y="11" width="24" height="2" transform="rotate(-45 12 12)"></rect>
    </g>
  </svg>
</button>
