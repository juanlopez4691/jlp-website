---
import { getRelativeLocaleUrl } from "astro:i18n"
import { cn } from "@/libs/utils"
import {
  locales,
  useTranslations,
  type Locale,
  type Translations,
} from "@/i18n"

interface Props {
  /** Language of the current page. */
  locale: Locale
  /** The URL of this page in each language that has it. */
  translations?: Translations
  class?: string
}

const { locale, translations, class: className } = Astro.props
const navLang = useTranslations(locale, "navLang")
---

<nav
  aria-label={navLang.label}
  class={cn("flex items-center gap-2 text-base", className)}
>
  {locales.map((code, index) => (
    <>
      {index > 0 && <span aria-hidden="true">/</span>}
      <a
        href={translations?.[code] ?? getRelativeLocaleUrl(code)}
        hreflang={code}
        lang={code}
        aria-current={
          code === locale && translations?.[code] ? "page" : undefined
        }
        class={cn(
          "uppercase underline-offset-4 outline-ink focus-visible:outline-2 focus-visible:outline-offset-4",
          code === locale && "underline"
        )}
      >
        {code}
      </a>
    </>
  ))}
</nav>
