---
import { getRelativeLocaleUrl } from "astro:i18n"
import { cn } from "@/libs/utils"
import { locales, useTranslations, type Locale } from "@/i18n"

interface Props {
  /** Language of the current page. */
  locale: Locale
  class?: string
}

const { locale, class: className } = Astro.props
const t = useTranslations(locale)
---

<nav
  aria-label={t.nav.languageLabel}
  class={cn("flex items-center gap-2 text-base", className)}
>
  {locales.map((code, index) => (
    <>
      {index > 0 && <span aria-hidden="true">/</span>}
      <a
        href={getRelativeLocaleUrl(code)}
        hreflang={code}
        lang={code}
        aria-current={code === locale ? "page" : undefined}
        class={cn(
          "font-semibold uppercase underline-offset-4 outline-navy focus-visible:outline-2 focus-visible:outline-offset-4",
          code === locale ? "underline" : "opacity-70"
        )}
      >
        {code}
      </a>
    </>
  ))}
</nav>
