---
import { getRelativeLocaleUrl } from "astro:i18n"
import { cn } from "@/libs/utils"
import { locales, useTranslations, type Dictionary, type Locale } from "@/i18n"

interface Props {
  /** Language of the current page. */
  locale: Locale
  /** Replaces part of this component's default copy on one page. */
  copy?: Partial<Dictionary["navLang"]>
  class?: string
}

const { locale, copy, class: className } = Astro.props
const navLang = { ...useTranslations(locale, "navLang"), ...copy }
---

<nav
  aria-label={navLang.label}
  class={cn("flex items-center gap-2 text-base", className)}
>
  {locales.map((code, index) => (
    <>
      {index > 0 && <span aria-hidden="true">/</span>}
      <a
        href={getRelativeLocaleUrl(code)}
        hreflang={code}
        lang={code}
        aria-current={code === locale ? "page" : undefined}
        class={cn(
          "uppercase underline-offset-4 outline-ink focus-visible:outline-2 focus-visible:outline-offset-4",
          code === locale && "font-semibold underline"
        )}
      >
        {code}
      </a>
    </>
  ))}
</nav>
