---
import type { HTMLAttributes } from "astro/types"
import { cn } from "@/libs/utils"

/** A navigation link. The caller styles hover and the current link (`aria-current`). */
interface Props extends HTMLAttributes<"a"> {
  /** Where the link points, already localized. */
  href: string
}

const { href, class: className, ...rest } = Astro.props
---

<a
  {...rest}
  href={href}
  class={cn(
    "text-base text-ink outline-ink focus-visible:outline-2 focus-visible:outline-offset-4",
    className
  )}
>
  <slot />
</a>
