---
import { cn } from "@/libs/utils"

interface Props {
  /** Where the link points, already localized. */
  href: string
  class?: string
}

const { href, class: className } = Astro.props
---

<a
  href={href}
  class={cn(
    "text-base font-semibold text-navy underline-offset-4 outline-navy focus-visible:outline-2 focus-visible:outline-offset-4 aria-[current]:underline",
    className
  )}
>
  <slot />
</a>
