---
import { cn } from "@/libs/utils"

interface Props {
  /**
   * What the pill labels: the hero availability, a technology chip (outline or
   * filled) or the period of a job.
   */
  kind: "availability" | "chip" | "date" | "chip-filled"
  /** The surface the pill sits on. Colors the text of an outline chip only. */
  tone?: "on-light" | "on-dark"
  class?: string
}

const { kind, tone = "on-light", class: className } = Astro.props

/** Whole class strings, so Tailwind sees them. */
const kinds = {
  availability:
    "inline-flex items-center gap-2 rounded-full bg-ink py-2 pr-4 pl-2.5 text-sm leading-normal font-semibold text-mint",
  chip: "inline-flex items-center rounded-full border-[1.5px] border-current px-3 py-1 text-sm leading-pill font-medium",
  date: "inline-flex items-center rounded-full bg-saffron px-4 py-2 text-sm leading-normal font-semibold whitespace-nowrap text-ink",
  "chip-filled":
    "inline-flex items-center rounded-full border-[1.5px] border-saffron bg-saffron px-3 py-1 text-sm leading-pill font-medium text-ink",
}

/** Only the outline chip has a tone: the availability and filled chips do not. */
const tones = {
  "on-light": "text-ink",
  "on-dark": "text-mint",
}
---

<span class={cn(kinds[kind], kind === "chip" && tones[tone], className)}>
  {kind === "availability" && (
    <span class="size-2.5 shrink-0 rounded-full bg-saffron" />
  )}
  <slot />
</span>
