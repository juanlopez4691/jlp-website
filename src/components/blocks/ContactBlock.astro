---
import type { ComponentProps } from "astro/types"
import { Image } from "astro:assets"
import Button from "@/components/atoms/Button.astro"
import SectionArrow from "@/components/atoms/SectionArrow.astro"
import SectionHeader from "@/components/molecules/SectionHeader.astro"
import telephones from "@/assets/telephones.webp"
import { cn } from "@/libs/utils"
import { useTranslations, type Locale } from "@/i18n"
import type { ContactBlockCopy } from "@/libs/blocks"

interface Props {
  /** Language of the current page. */
  locale: Locale
  id?: string
  /** Replaces part of this component's default copy on one page. */
  copy?: ContactBlockCopy
  /** Color of the block above. Without it, the block has no arrow. */
  arrow?: ComponentProps<typeof SectionArrow>["color"]
  class?: string
}

const { locale, id, copy, arrow, class: className } = Astro.props
const contact = { ...useTranslations(locale, "contact"), ...copy }
const navigation = useTranslations(locale, "navigation")
---

<section
  id={id}
  class={cn(
    "relative overflow-hidden bg-teal py-16 text-mint md:py-20",
    className
  )}
>
  <div class="group relative isolate mx-auto max-w-6xl px-8 xl:px-0">
    <Image
      src={telephones}
      alt=""
      width={628}
      densities={[1, 2]}
      format="avif"
      quality={35}
      class="absolute -top-18.5 right-0 -z-10 hidden h-auto w-157 motion-safe:hover:animate-shake motion-safe:group-has-[[data-shake]:hover]:animate-shake md:block"
    />
    <SectionHeader
      tone="on-dark"
      eyebrow={contact.eyebrow}
      title={contact.title}
      class="md:max-w-124 xl:max-w-155"
    />
    <a
      href={`mailto:${contact.address}`}
      data-shake
      class="mt-4 inline-block text-3xl leading-none font-normal tracking-tight wrap-break-word text-saffron focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-saffron md:text-5xl xl:text-7xl"
    >
      {contact.address}
    </a>
    <div class="mt-10 flex flex-col gap-4 md:w-fit md:flex-row">
      <Button type="primary-on-dark" href={`mailto:${contact.address}`}>
        {contact.email}
      </Button>
      <Button
        type="secondary-on-dark"
        href={navigation.external.linkedin.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        {navigation.external.linkedin.label}
        <span class="sr-only">{navigation.newTab}</span>
      </Button>
    </div>
    <p class="mt-4 text-base leading-relaxed md:w-fit">{contact.note}</p>
  </div>
  {arrow && <SectionArrow color={arrow} />}
</section>
