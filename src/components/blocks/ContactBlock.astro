---
import type { ComponentProps } from "astro/types"
import { Image } from "astro:assets"
import Button from "@/components/atoms/Button.astro"
import SectionArrow from "@/components/atoms/SectionArrow.astro"
import SectionHeader from "@/components/molecules/SectionHeader.astro"
import telephones from "@/assets/telephones.webp"
import { cn } from "@/libs/utils"
import { useTranslations, type Locale } from "@/i18n"

interface Props {
  /** Language of the current page. */
  locale: Locale
  /** Color of the block above. Without it, the block has no arrow. */
  arrow?: ComponentProps<typeof SectionArrow>["color"]
  class?: string
}

const { locale, arrow, class: className } = Astro.props
const { contact, recommendations } = useTranslations(locale)
---

<section
  id="contact"
  class={cn(
    "relative overflow-hidden bg-teal py-16 text-mint md:py-20",
    className
  )}
>
  <div class="relative isolate mx-auto max-w-6xl px-8 xl:px-0">
    <Image
      src={telephones}
      alt=""
      width={628}
      densities={[1, 2]}
      format="avif"
      quality={35}
      class="pointer-events-none absolute -top-18.5 -right-10.5 -z-10 hidden h-auto w-157 md:block xl:-right-26.75"
    />
    <SectionHeader
      tone="on-dark"
      eyebrow={contact.eyebrow}
      title={contact.title}
      class="flex flex-col gap-4 md:max-w-176 xl:max-w-178.5"
    />
    <a
      href={`mailto:${contact.address}`}
      class="mt-4 inline-block text-3xl leading-none font-normal tracking-tight wrap-break-word text-saffron focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-saffron md:text-5xl xl:text-7xl"
    >
      {contact.address}
    </a>
    <div class="mt-10 flex flex-col gap-4 md:flex-row">
      <Button type="accent" href={`mailto:${contact.address}`}>
        {contact.email}
      </Button>
      <Button
        type="secondary-on-dark"
        href={contact.linkedinHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        {contact.linkedin}
        <span class="sr-only">{recommendations.newTab}</span>
      </Button>
    </div>
    <p class="mt-4 text-base leading-relaxed">{contact.note}</p>
  </div>
  {arrow && <SectionArrow color={arrow} />}
</section>
