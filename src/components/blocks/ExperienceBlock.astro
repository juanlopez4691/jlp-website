---
import type { ComponentProps } from "astro/types"
import SectionArrow from "@/components/atoms/SectionArrow.astro"
import SectionHeader from "@/components/molecules/SectionHeader.astro"
import JobRow from "@/components/molecules/JobRow.astro"
import Slider from "@/components/molecules/Slider.astro"
import { cn } from "@/libs/utils"
import type { Locale } from "@/i18n"
import type { ExperienceBlockCopy } from "@/libs/blocks"

type Props = ExperienceBlockCopy & {
  id?: string
  /** Color of the block above. Without it, the block has no arrow. */
  arrow?: ComponentProps<typeof SectionArrow>["color"]
  locale: Locale
  class?: string
}

const { id, arrow, locale, class: className, ...experience } = Astro.props

const titleId = `${id ?? "experience"}-title`

/** The first job opens the log and the last one closes it. */
const position = (index: number): "first" | "middle" | "last" => {
  if (index === 0) return "first"
  if (index === experience.jobs.length - 1) return "last"
  return "middle"
}
---

<section
  id={id}
  class={cn("relative bg-mint py-16 text-ink md:py-20", className)}
>
  {arrow && <SectionArrow color={arrow} />}
  <div class="mx-auto max-w-6xl px-8 xl:px-0">
    <SectionHeader
      eyebrow={experience.eyebrow}
      title={experience.title}
      titleId={titleId}
    />
    <Slider
      as="ol"
      labelledby={titleId}
      locale={locale}
      class="mt-12"
      trackClass={cn(
        "grid grid-cols-[auto_1fr] gap-x-6 pl-8",
        "slider:grid-cols-none slider:items-start slider:[--gap:2rem]",
        experience.jobs.length > 1 &&
          "slider:[--slide:90%] slider:min-[680px]:slide-half"
      )}
    >
      {experience.jobs.map((job, index) => (
        <JobRow
          period={job.period}
          title={job.title}
          company={job.company}
          position={position(index)}
          class="md:motion-safe:scroll-triggered:reveal"
        >
          {job.body}
        </JobRow>
      ))}
    </Slider>
  </div>
</section>
