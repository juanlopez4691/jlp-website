---
import { getRelativeLocaleUrl } from "astro:i18n"
import IconExternalLink from "@/components/atoms/IconExternalLink.astro"
import NavLink from "@/components/atoms/NavLink.astro"
import { cn } from "@/libs/utils"
import { useTranslations, type Locale } from "@/i18n"

interface Props {
  /** Language of the current page. */
  locale: Locale
  class?: string
}

interface FooterLink {
  label: string
  href: string
  download?: boolean
  target?: string
  rel?: string
  hint?: string
}

const { locale, class: className } = Astro.props
const footer = useTranslations(locale, "footer")
const navigation = useTranslations(locale, "navigation")
const home = getRelativeLocaleUrl(locale)
const year = new Date().getFullYear()

/** Home and the page sections, in the order of the design, which lays them out as two columns of four (`grid-rows-4`). */
const siteLinks: FooterLink[] = Object.entries(navigation.sections).map(
  ([anchor, label]) => ({
    label,
    href: anchor === "home" ? home : `${home}#${anchor}`,
  })
)

const externalLinks: FooterLink[] = [
  {
    label: navigation.external.linkedin.label,
    href: navigation.external.linkedin.href,
    target: "_blank",
    rel: "noopener noreferrer",
    hint: navigation.newTab,
  },
  {
    label: navigation.external.github.label,
    href: navigation.external.github.href,
    target: "_blank",
    rel: "noopener noreferrer",
    hint: navigation.newTab,
  },
  {
    label: navigation.external.cv.label,
    href: navigation.external.cv.href,
    download: true,
  },
]

const legalLinks: FooterLink[] = navigation.legal.map(({ label, slug }) => ({
  label,
  href: getRelativeLocaleUrl(locale, slug),
}))
---

<footer class={cn("bg-ink py-8 text-mint", className)}>
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-8 xl:px-0">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <nav aria-label={footer.navLabel}>
        <ul class="grid w-max grid-flow-col grid-rows-4 gap-x-12 gap-y-2">
          {siteLinks.map((link) => (
            <li>
              <NavLink href={link.href} class="text-mint outline-mint">
                {link.label}
              </NavLink>
            </li>
          ))}
        </ul>
      </nav>

      <ul class="flex flex-col items-start gap-2">
        {externalLinks.map((link) => (
          <li>
            <NavLink
              href={link.href}
              download={link.download}
              target={link.target}
              rel={link.rel}
              class={cn(
                "text-mint outline-mint",
                link.hint && "inline-flex items-baseline gap-2"
              )}
            >
              {link.label}
              {link.hint && <span class="sr-only">{link.hint}</span>}
              {link.hint && <IconExternalLink />}
            </NavLink>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex flex-col gap-4 border-t border-mint py-2 md:flex-row md:items-baseline md:justify-between md:gap-0">
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-2 md:gap-x-3">
        {legalLinks.map((link, index) => (
          <li class="flex items-center gap-4 md:gap-3">
            {index > 0 && (
              <span aria-hidden="true" class="text-base">
                •
              </span>
            )}
            <NavLink href={link.href} class="text-mint outline-mint">
              {link.label}
            </NavLink>
          </li>
        ))}
      </ul>

      <p class="text-sm leading-tight">
        © {year} {footer.name}
      </p>
    </div>
  </div>
</footer>
