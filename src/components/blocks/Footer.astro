---
import { getRelativeLocaleUrl } from "astro:i18n"
import NavLink from "@/components/atoms/NavLink.astro"
import { cn } from "@/libs/utils"
import { useTranslations, type Locale } from "@/i18n"

interface Props {
  /** Language of the current page. */
  locale: Locale
  class?: string
}

interface FooterLink {
  label: string
  href: string
  download?: boolean
  target?: string
  rel?: string
  hint?: string
}

const { locale, class: className } = Astro.props
const t = useTranslations(locale)
const year = new Date().getFullYear()

const primaryLinks: FooterLink[] = [
  { label: t.hero.cv, href: t.hero.cvHref, download: true },
  {
    label: t.footer.github,
    href: t.footer.githubHref,
    target: "_blank",
    rel: "noopener noreferrer",
    hint: t.recommendations.newTab,
  },
]

const legalLinks: FooterLink[] = t.footer.legal.map(({ label, slug }) => ({
  label,
  href: getRelativeLocaleUrl(locale, `${slug}/`),
}))

const linkGroups = [primaryLinks, legalLinks]
---

<footer class={cn("bg-navy py-6 text-mint", className)}>
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-4 px-8 md:min-h-8 md:flex-row md:items-center md:justify-between xl:px-0">
    {linkGroups.map((links) => (
      <ul class="flex flex-wrap items-center gap-x-3 gap-y-2">
        {links.map((link, index) => (
          <li class="flex items-center gap-3">
            {index > 0 && (
              <span aria-hidden="true" class="leading-relaxed">
                •
              </span>
            )}
            <NavLink
              href={link.href}
              download={link.download}
              target={link.target}
              rel={link.rel}
              class="text-mint outline-mint"
            >
              {link.label}
              {link.hint && <span class="sr-only">{link.hint}</span>}
            </NavLink>
          </li>
        ))}
      </ul>
    ))}
    <p class="leading-relaxed">
      © {year} {t.hero.name}
    </p>
  </div>
</footer>
