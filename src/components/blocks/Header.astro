---
import { getRelativeLocaleUrl } from "astro:i18n"
import MenuButton from "@/components/atoms/MenuButton.astro"
import NavLang from "@/components/atoms/NavLang.astro"
import NavLink from "@/components/atoms/NavLink.astro"
import { cn } from "@/libs/utils"
import { useTranslations, type Locale, type Translations } from "@/i18n"

interface Props {
  /** Language of the current page. */
  locale: Locale
  /** The URL of this page in each language that has it. */
  translations?: Translations
  class?: string
}

const { locale, translations, class: className } = Astro.props
const header = useTranslations(locale, "header")
const navigation = useTranslations(locale, "navigation")
const home = getRelativeLocaleUrl(locale)

/** Home and the page sections, in the order of the design. */
const links = Object.entries(navigation.sections).map(([anchor, label]) => ({
  label,
  href: `${home}#${anchor}`,
}))

/**
 * The underline grows from the left on hover and on the current link. It is a
 * border, so it stays in forced-colors mode.
 */
const underline =
  "relative after:absolute after:inset-x-0 after:-bottom-0.5 after:origin-left after:scale-x-0 after:border-b-2 after:transition-transform after:duration-300 hover:after:scale-x-100 aria-[current]:after:scale-x-100 motion-reduce:after:transition-none"
---

{/* The negative top equals the 32px animation range; each row moves half of it. */}
<header
  data-site-header
  class={cn(
    "z-50 bg-saffron py-8 scroll-driven:sticky scroll-driven:-top-8 scroll-driven:border-b scroll-driven:border-transparent scroll-driven:[animation-name:header-border] scroll-driven:scroll-linked scroll-driven:[animation-range:0_1px]",
    className
  )}
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-8 xl:px-0 scroll-driven:[animation-name:header-shrink] scroll-driven:scroll-linked scroll-driven:[animation-range:0_32px]">
    <nav
      aria-label={header.sectionsLabel}
      class="hidden items-center gap-8 lg:flex"
    >
      {links.map((link) => (
        <NavLink
          href={link.href}
          data-nav-link
          class={cn("font-semibold", underline)}
        >
          {link.label}
        </NavLink>
      ))}
    </nav>

    <NavLang
      locale={locale}
      translations={translations}
      class="font-semibold"
    />

    <MenuButton
      data-menu-toggle
      label={header.openMenu}
      aria-controls="site-menu"
      class="lg:hidden"
    />
  </div>

  <dialog
    id="site-menu"
    data-menu-panel
    class="fixed inset-0 size-full max-h-none max-w-none flex-col overflow-y-auto bg-saffron open:flex lg:hidden"
  >
    <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-8 py-8 scroll-driven:[animation-name:header-menu-shrink] scroll-driven:scroll-linked scroll-driven:[animation-range:0_32px]">
      <NavLang
        locale={locale}
        translations={translations}
        class="font-semibold"
      />
      <MenuButton
        data-menu-toggle
        label={header.closeMenu}
        aria-controls="site-menu"
        expanded
      />
    </div>

    <nav
      aria-label={header.sectionsLabel}
      data-menu-links
      class="mx-auto flex w-full max-w-6xl flex-col items-start gap-6 px-8 py-8"
    >
      {links.map((link) => (
        <NavLink
          href={link.href}
          data-nav-link
          class={cn("font-display text-2xl font-bold leading-tight", underline)}
        >
          {link.label}
        </NavLink>
      ))}
    </nav>
  </dialog>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 -bottom-px hidden h-1 origin-left scale-x-0 bg-ink scroll-driven:block scroll-driven:[animation-name:header-progress] scroll-driven:scroll-linked"
  ></div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]")

  if (header) {
    const panel = header.querySelector<HTMLDialogElement>("[data-menu-panel]")
    const buttons =
      header.querySelectorAll<HTMLButtonElement>("[data-menu-toggle]")
    const menuLinks = header.querySelector<HTMLElement>("[data-menu-links]")

    if (panel) {
      const syncExpanded = () => {
        buttons.forEach((button) => {
          button.setAttribute("aria-expanded", String(panel.open))
        })
      }

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          if (panel.open) panel.close()
          else {
            panel.showModal()
            menuLinks?.querySelector<HTMLElement>("a")?.focus()
          }
          syncExpanded()
        })
      })

      panel.addEventListener("click", (event) => {
        const link =
          event.target instanceof Element && event.target.closest("a")
        if (link) panel.close()
      })

      // Escape, and the focus it hands back to the button, come from the
      // dialog. Growing past the panel's breakpoint does not: close it there.
      const wide = window.matchMedia("(min-width: 64rem)") // Tailwind's `lg`
      wide.addEventListener("change", (event) => {
        if (event.matches) panel.close()
      })

      panel.addEventListener("close", syncExpanded)
    }

    // Mark the section in view. Links to another page are never marked.
    const sectionLinks = [
      ...header.querySelectorAll<HTMLAnchorElement>("a[data-nav-link]"),
    ].filter((link) => link.pathname === location.pathname)
    const sections = [
      ...new Set(sectionLinks.map((link) => link.hash.slice(1))),
    ]
      .map((id) => document.getElementById(id))
      .filter((section) => section !== null)

    // Last section past a third of the viewport, or the last one at the bottom.
    const markSection = () => {
      const line = window.innerHeight / 3
      const atBottom =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 1
      let current = "#top"
      sections.forEach((section) => {
        if (atBottom || section.getBoundingClientRect().top <= line)
          current = `#${section.id}`
      })
      sectionLinks.forEach((link) => {
        if (link.hash === current) link.setAttribute("aria-current", "location")
        else link.removeAttribute("aria-current")
      })
    }

    markSection()
    window.addEventListener("scroll", markSection, { passive: true })
    window.addEventListener("resize", markSection)
  }
</script>
