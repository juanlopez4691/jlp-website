---
import { getRelativeLocaleUrl } from "astro:i18n"
import MenuButton from "@/components/atoms/MenuButton.astro"
import NavLang from "@/components/atoms/NavLang.astro"
import NavLink from "@/components/atoms/NavLink.astro"
import { cn } from "@/libs/utils"
import {
  useTranslations,
  type Dictionary,
  type Locale,
  type Translations,
} from "@/i18n"

interface Props {
  /** Language of the current page. */
  locale: Locale
  /** The URL of this page in each language that has it. */
  translations?: Translations
  /** Replaces part of this component's default copy on one page. */
  copy?: Partial<Dictionary["header"]>
  class?: string
}

const { locale, translations, copy, class: className } = Astro.props
const header = { ...useTranslations(locale, "header"), ...copy }
const navigation = useTranslations(locale, "navigation")
const home = getRelativeLocaleUrl(locale)

/** Home and the page sections, in the order of the design. */
const links = Object.entries(navigation.sections).map(([anchor, label]) => ({
  label,
  href: anchor === "home" ? home : `${home}#${anchor}`,
}))
---

<header data-site-header class={cn("bg-saffron", className)}>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-8 py-8 xl:px-0">
    <nav
      aria-label={header.sectionsLabel}
      class="hidden items-center gap-8 lg:flex"
    >
      {links.map((link) => (
        <NavLink href={link.href} data-nav-link class="font-semibold">
          {link.label}
        </NavLink>
      ))}
    </nav>

    <NavLang
      locale={locale}
      translations={translations}
      class="font-semibold"
    />

    <MenuButton
      data-menu-toggle
      label={header.openMenu}
      aria-controls="site-menu"
      class="lg:hidden"
    />
  </div>

  <dialog
    id="site-menu"
    data-menu-panel
    class="fixed inset-0 size-full max-h-none max-w-none flex-col overflow-y-auto bg-saffron open:flex lg:hidden"
  >
    <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-8 py-8">
      <NavLang
        locale={locale}
        translations={translations}
        class="font-semibold"
      />
      <MenuButton
        data-menu-toggle
        label={header.closeMenu}
        aria-controls="site-menu"
        expanded
      />
    </div>

    <nav
      aria-label={header.sectionsLabel}
      data-menu-links
      class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-8 py-8"
    >
      {links.map((link) => (
        <NavLink
          href={link.href}
          data-nav-link
          class="font-display text-2xl font-bold leading-tight"
        >
          {link.label}
        </NavLink>
      ))}
    </nav>
  </dialog>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]")

  if (header) {
    const panel = header.querySelector<HTMLDialogElement>("[data-menu-panel]")
    const buttons =
      header.querySelectorAll<HTMLButtonElement>("[data-menu-toggle]")
    const menuLinks = header.querySelector<HTMLElement>("[data-menu-links]")

    if (panel) {
      const syncExpanded = () => {
        buttons.forEach((button) => {
          button.setAttribute("aria-expanded", String(panel.open))
        })
      }

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          if (panel.open) panel.close()
          else {
            panel.showModal()
            menuLinks?.querySelector<HTMLElement>("a")?.focus()
          }
          syncExpanded()
        })
      })

      panel.addEventListener("click", (event) => {
        const link =
          event.target instanceof Element && event.target.closest("a")
        if (link) panel.close()
      })

      // Escape, and the focus it hands back to the button, come from the
      // dialog. Growing past the panel's breakpoint does not: close it there.
      const wide = window.matchMedia("(min-width: 64rem)") // Tailwind's `lg`
      wide.addEventListener("change", (event) => {
        if (event.matches) panel.close()
      })

      panel.addEventListener("close", syncExpanded)
    }

    // Mark the section the URL points at, in the bar and in the panel.
    const sectionLinks =
      header.querySelectorAll<HTMLAnchorElement>("a[data-nav-link]")

    const markSection = () => {
      sectionLinks.forEach((link) => {
        if (link.pathname === location.pathname && link.hash === location.hash)
          link.setAttribute("aria-current", "location")
        else link.removeAttribute("aria-current")
      })
    }

    markSection()
    window.addEventListener("hashchange", markSection)
  }
</script>
