---
import { getRelativeLocaleUrl } from "astro:i18n"
import MenuButton from "@/components/atoms/MenuButton.astro"
import NavLang from "@/components/atoms/NavLang.astro"
import NavLink from "@/components/atoms/NavLink.astro"
import { cn } from "@/libs/utils"
import { useTranslations, type Locale } from "@/i18n"

interface Props {
  /** Language of the current page. */
  locale: Locale
  class?: string
}

const { locale, class: className } = Astro.props
const t = useTranslations(locale)
const home = getRelativeLocaleUrl(locale)

/** The seven sections of the home page, in the order of the design. */
const links = Object.entries(t.nav.links).map(([anchor, label]) => ({
  label,
  href: `${home}#${anchor}`,
}))
---

<header data-site-header class={cn("bg-saffron", className)}>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-8 py-8 xl:px-0">
    <nav
      aria-label={t.nav.sectionsLabel}
      class="hidden items-center gap-8 xl:flex"
    >
      {links.map((link) => (
        <NavLink href={link.href}>{link.label}</NavLink>
      ))}
    </nav>

    <NavLang locale={locale} />

    <MenuButton
      data-menu-toggle
      label={t.nav.openMenu}
      controls="site-menu"
      class="xl:hidden"
    />
  </div>

  <dialog
    id="site-menu"
    data-menu-panel
    class="fixed inset-0 size-full max-h-none max-w-none flex-col overflow-y-auto bg-saffron open:flex xl:hidden"
  >
    <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-8 py-8">
      <NavLang locale={locale} />
      <MenuButton
        data-menu-toggle
        label={t.nav.closeMenu}
        controls="site-menu"
        expanded
      />
    </div>

    <nav
      aria-label={t.nav.sectionsLabel}
      data-menu-links
      class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-8 py-8"
    >
      {links.map((link) => (
        <NavLink
          href={link.href}
          class="font-display text-2xl font-bold leading-tight"
        >
          {link.label}
        </NavLink>
      ))}
    </nav>
  </dialog>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]")

  if (header) {
    const panel = header.querySelector<HTMLDialogElement>("[data-menu-panel]")
    const buttons =
      header.querySelectorAll<HTMLButtonElement>("[data-menu-toggle]")
    const menuLinks = header.querySelector<HTMLElement>("[data-menu-links]")

    if (panel) {
      const syncExpanded = () => {
        buttons.forEach((button) => {
          button.setAttribute("aria-expanded", String(panel.open))
        })
      }

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          if (panel.open) panel.close()
          else {
            panel.showModal()
            menuLinks?.querySelector<HTMLElement>("a")?.focus()
          }
          syncExpanded()
        })
      })

      panel.addEventListener("click", (event) => {
        const link =
          event.target instanceof Element && event.target.closest("a")
        if (link) panel.close()
      })

      // Escape, and the focus it hands back to the button, come from the
      // dialog. Growing past the panel's breakpoint does not: close it there.
      const wide = window.matchMedia("(min-width: 80rem)") // Tailwind's `xl`
      wide.addEventListener("change", (event) => {
        if (event.matches) panel.close()
      })

      panel.addEventListener("close", syncExpanded)
    }

    // Mark the section the URL points at, in the bar and in the panel.
    const sectionLinks =
      header.querySelectorAll<HTMLAnchorElement>("a[href*='#']")

    const markSection = () => {
      const { hash } = window.location
      sectionLinks.forEach((link) => {
        const current = hash !== "" && link.hash === hash
        if (current) link.setAttribute("aria-current", "location")
        else if (link.getAttribute("aria-current") === "location")
          link.removeAttribute("aria-current")
      })
    }

    markSection()
    window.addEventListener("hashchange", markSection)
  }
</script>
