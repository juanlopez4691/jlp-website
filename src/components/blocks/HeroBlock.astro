---
import { getRelativeLocaleUrl } from "astro:i18n"
import { Image } from "astro:assets"
import Button from "@/components/atoms/Button.astro"
import Pill from "@/components/atoms/Pill.astro"
import blacksmith from "@/assets/blacksmith.webp"
import { cn } from "@/libs/utils"
import { useTranslations, type Dictionary, type Locale } from "@/i18n"

interface Props {
  /** Language of the current page. */
  locale: Locale
  /** Replaces part of this component's default copy on one page. */
  copy?: Partial<Dictionary["hero"]>
  class?: string
}

const { locale, copy, class: className } = Astro.props
const hero = { ...useTranslations(locale, "hero"), ...copy }
const navigation = useTranslations(locale, "navigation")
const home = getRelativeLocaleUrl(locale)
---

<section class={cn("bg-saffron pt-6 pb-16 md:pb-20", className)}>
  <div class="mx-auto flex max-w-6xl items-start gap-8 px-8 xl:px-0">
    <div class="flex-1 md:mx-auto md:max-w-140 lg:mx-0 lg:w-116 lg:max-w-none lg:flex-none">
      <Pill kind="availability" class="w-full md:w-auto">
        <span class="md:hidden">{hero.availabilityShort}</span>
        <span class="hidden md:inline">{hero.availability}</span>
      </Pill>
      <h1 class="mt-6 text-6xl leading-none font-bold tracking-tight md:text-7xl xl:text-8xl xl:leading-h1">
        {hero.greeting} <br class="hidden lg:inline" />
        {hero.name}
      </h1>
      <p class="mt-6 font-display text-2xl leading-tight font-medium">
        {hero.role}
      </p>
      <p class="mt-3 font-display text-2xl leading-tight font-bold">
        {hero.tagline}
      </p>
      <p class="mt-3 text-lg leading-normal">{hero.lead}</p>
      <div class="mt-6 flex flex-col gap-4 md:flex-row">
        <Button type="primary" href={`${home}#contact`}>
          {hero.contact}
        </Button>
        <Button type="secondary" href={navigation.external.cv.href} download>
          {navigation.external.cv.label}
        </Button>
      </div>
    </div>
    <Image
      src={blacksmith}
      alt={hero.imageAlt}
      width={656}
      densities={[1, 2]}
      format="avif"
      quality={35}
      fetchpriority="high"
      class="hidden h-auto min-w-0 flex-1 lg:block"
    />
  </div>
</section>
