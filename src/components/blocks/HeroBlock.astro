---
import { getRelativeLocaleUrl } from "astro:i18n"
import { getImage } from "astro:assets"
import Button from "@/components/atoms/Button.astro"
import Pill from "@/components/atoms/Pill.astro"
import blacksmith from "@/assets/blacksmith.webp"
import { cn } from "@/libs/utils"
import { useTranslations, type Locale } from "@/i18n"
import type { HeroBlockCopy } from "@/libs/blocks"

type Props = HeroBlockCopy & {
  /** Language of the current page. */
  locale: Locale
  id?: string
  class?: string
}

const { locale, id, class: className, ...hero } = Astro.props
const navigation = useTranslations(locale, "navigation")
const home = getRelativeLocaleUrl(locale)

// Hidden below `lg`, where a blank GIF keeps it from downloading. `<Image>`
// can only skip it with `loading="lazy"`, which delays the LCP.
const image = await getImage({
  src: blacksmith,
  width: 656,
  densities: [1, 2],
  format: "avif",
  quality: 35,
})
const blank =
  "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
---

<section id={id} class={cn("bg-saffron pt-6 pb-16 md:pb-20", className)}>
  <div class="mx-auto flex max-w-6xl items-start gap-0 md:gap-2 xl:gap-8 px-8 xl:px-0">
    <div class="flex-1 md:mx-auto md:max-w-140 lg:mx-0 lg:w-116 lg:max-w-none lg:flex-none">
      <Pill kind="availability" class="w-full md:w-auto">
        <span class="md:hidden">{hero.availabilityShort}</span>
        <span class="hidden md:inline">{hero.availability}</span>
      </Pill>
      <h1 class="mt-6 text-6xl leading-none font-bold tracking-tight md:text-7xl xl:text-8xl xl:leading-h1">
        {hero.greeting} <br class="hidden lg:inline" />
        {hero.name}
      </h1>
      <p class="mt-6 font-display text-2xl leading-tight font-medium">
        {hero.role}
      </p>
      <p class="mt-3 font-display text-2xl leading-tight font-bold">
        {hero.tagline}
      </p>
      <p class="mt-3 text-lg leading-normal">{hero.lead}</p>
      <div class="mt-6 flex flex-col gap-4 sm:flex-row">
        <Button type="primary" href={`${home}#contact`}>
          {hero.contact}
        </Button>
        <Button type="secondary" href={navigation.external.cv.href} download>
          {navigation.external.cv.label}
        </Button>
      </div>
    </div>
    <picture class="contents">
      <source
        media="(min-width: 1024px)"
        srcset={image.srcSet.attribute}
        type="image/avif"
      />
      <source srcset={blank} />
      <img
        src={image.src}
        alt={hero.imageAlt}
        width={image.attributes.width}
        height={image.attributes.height}
        fetchpriority="high"
        class="hidden h-auto min-w-0 flex-1 lg:block"
      />
    </picture>
  </div>
</section>
