---
import type { ComponentProps } from "astro/types"
import SectionArrow from "@/components/atoms/SectionArrow.astro"
import SectionHeader from "@/components/molecules/SectionHeader.astro"
import Step from "@/components/molecules/Step.astro"
import Principle from "@/components/molecules/Principle.astro"
import { cn } from "@/libs/utils"
import type { HowBlockCopy } from "@/libs/blocks"

type Props = HowBlockCopy & {
  id?: string
  /** Color of the block above. Without it, the block has no arrow. */
  arrow?: ComponentProps<typeof SectionArrow>["color"]
  class?: string
}

const { id, arrow, class: className, ...process } = Astro.props
---

<section
  id={id}
  class={cn("relative bg-coral py-16 text-ink md:py-20", className)}
>
  {arrow && <SectionArrow color={arrow} />}
  <div class="mx-auto max-w-6xl px-8 xl:px-0">
    <SectionHeader eyebrow={process.eyebrow} title={process.title} />
    <ol class="reveal-stagger-4 mt-12 grid gap-8 md:grid-cols-2 md:gap-y-10 lg:grid-cols-4 lg:gap-x-10">
      {process.steps.map((step) => (
        <li class="motion-safe:scroll-triggered:reveal">
          <Step title={step.title} class="motion-safe:scroll-triggered:relay">
            {step.body}
          </Step>
        </li>
      ))}
    </ol>
    <ul class="reveal-stagger-2 mt-20 grid gap-6 md:grid-cols-2 md:gap-x-8 md:gap-y-10 lg:gap-x-10">
      {process.principles.map((principle) => (
        <li class="motion-safe:scroll-triggered:reveal">
          <Principle title={principle.title}>{principle.body}</Principle>
        </li>
      ))}
    </ul>
  </div>
</section>
