---
import type { ComponentProps } from "astro/types"
import IconExternalLink from "@/components/atoms/IconExternalLink.astro"
import SectionArrow from "@/components/atoms/SectionArrow.astro"
import SectionHeader from "@/components/molecules/SectionHeader.astro"
import Quote from "@/components/molecules/Quote.astro"
import { cn } from "@/libs/utils"
import type { RecommendationsBlockCopy } from "@/libs/blocks"
import { useTranslations, type Locale } from "@/i18n"

interface Props {
  /** Language of the current page. */
  locale: Locale
  id?: string
  /** Replaces part of this component's default copy on one page. */
  copy: RecommendationsBlockCopy
  /** Color of the block above. Without it, the block has no arrow. */
  arrow?: ComponentProps<typeof SectionArrow>["color"]
  class?: string
}

const { locale, id, copy, arrow, class: className } = Astro.props
const recommendations = copy
const navigation = useTranslations(locale, "navigation")

/** The first item is the featured one, in the navy card. */
const [featured, ...rest] = recommendations.items
---

<section
  id={id}
  class={cn("relative bg-saffron py-16 text-ink md:py-20", className)}
>
  {arrow && <SectionArrow color={arrow} />}
  <div class="mx-auto max-w-6xl px-8 xl:px-0">
    <SectionHeader
      eyebrow={recommendations.eyebrow}
      title={recommendations.title}
    />
    <div class="mt-12 flex flex-col gap-6">
      <div class="motion-safe:scroll-triggered:reveal rounded-[28px] bg-navy p-6 text-mint md:p-8 lg:p-12">
        <Quote
          featured
          name={featured.name}
          role={featured.role}
          href={featured.href}
          photo={featured.photo}
          newTab={navigation.newTab}
        >
          {featured.quote.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </Quote>
      </div>
      <ul class="reveal-stagger-2 grid gap-6 md:grid-cols-2">
        {rest.map((item) => (
          <li class="motion-safe:scroll-triggered:reveal">
            <div class="h-full rounded-[28px] bg-white p-6 md:p-8">
              <Quote
                name={item.name}
                role={item.role}
                href={item.href}
                photo={item.photo}
                newTab={navigation.newTab}
              >
                {item.quote.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </Quote>
            </div>
          </li>
        ))}
      </ul>
      <a
        href={recommendations.allHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-baseline gap-2 self-end text-base leading-normal hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
      >
        {recommendations.all}
        <span class="sr-only">{navigation.newTab}</span>
        <IconExternalLink />
      </a>
    </div>
  </div>
</section>
