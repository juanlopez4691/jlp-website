---
import type { ComponentProps } from "astro/types"
import type { ImageMetadata } from "astro"
import IconExternalLink from "@/components/atoms/IconExternalLink.astro"
import SectionArrow from "@/components/atoms/SectionArrow.astro"
import SectionHeader from "@/components/molecules/SectionHeader.astro"
import Quote from "@/components/molecules/Quote.astro"
import carlosAlbertoGarciaDeLaCaleraDassi from "@/assets/recommendations/carlos-alberto-garcia-de-la-calera-dassi.jpeg"
import manuelBruschi from "@/assets/recommendations/manuel-bruschi.jpeg"
import juliaMestieri from "@/assets/recommendations/julia-mestieri.jpeg"
import jordiPallares from "@/assets/recommendations/jordi-pallares.jpeg"
import tomMursell from "@/assets/recommendations/tom-mursell.jpeg"
import { cn } from "@/libs/utils"
import { useTranslations, type Locale } from "@/i18n"

interface Props {
  /** Language of the current page. */
  locale: Locale
  /** Color of the block above. Without it, the block has no arrow. */
  arrow?: ComponentProps<typeof SectionArrow>["color"]
  class?: string
}

const { locale, arrow, class: className } = Astro.props
const { recommendations } = useTranslations(locale)

/** The photos, keyed by the item id the dictionary uses. */
const photos: Record<string, ImageMetadata> = {
  "carlos-alberto-garcia-de-la-calera-dassi":
    carlosAlbertoGarciaDeLaCaleraDassi,
  "manuel-bruschi": manuelBruschi,
  "julia-mestieri": juliaMestieri,
  "jordi-pallares": jordiPallares,
  "tom-mursell": tomMursell,
}

/** The first item is the featured one, in the navy card. */
const [featured, ...rest] = recommendations.items
---

<section
  id="recommendations"
  class={cn("relative bg-saffron py-16 text-navy md:py-20", className)}
>
  {arrow && <SectionArrow color={arrow} />}
  <div class="mx-auto max-w-6xl px-8 xl:px-0">
    <SectionHeader
      eyebrow={recommendations.eyebrow}
      title={recommendations.title}
    />
    <div class="mt-12 flex flex-col gap-6">
      <div class="rounded-[28px] bg-navy p-6 text-mint md:p-8 lg:p-12">
        <Quote
          featured
          name={featured.name}
          role={featured.role}
          href={featured.href}
          photo={photos[featured.id]}
          newTab={recommendations.newTab}
        >
          {featured.quote.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </Quote>
      </div>
      <ul class="grid gap-6 md:grid-cols-2">
        {rest.map((item) => (
          <li>
            <div class="h-full rounded-[28px] bg-white p-6 md:p-8">
              <Quote
                name={item.name}
                role={item.role}
                href={item.href}
                photo={photos[item.id]}
                newTab={recommendations.newTab}
              >
                {item.quote.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </Quote>
            </div>
          </li>
        ))}
      </ul>
      <a
        href={recommendations.allHref}
        target="_blank"
        rel="noopener noreferrer"
        class="self-end text-base leading-normal font-semibold hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
      >
        {recommendations.all}
        <span class="sr-only">{recommendations.newTab}</span>
        <IconExternalLink class="ml-2" />
      </a>
    </div>
  </div>
</section>
