---
import type { ComponentProps } from "astro/types"
import SectionArrow from "@/components/atoms/SectionArrow.astro"
import SectionHeader from "@/components/molecules/SectionHeader.astro"
import ServiceCard from "@/components/molecules/ServiceCard.astro"
import { cn } from "@/libs/utils"
import type { ServicesBlockCopy } from "@/libs/blocks"

type Props = ServicesBlockCopy & {
  id?: string
  /** Color of the block above. Without it, the block has no arrow. */
  arrow?: ComponentProps<typeof SectionArrow>["color"]
  class?: string
}

const { id, arrow, class: className, ...services } = Astro.props

/** The fill rotates per card, as the design has it. */
const tones = ["saffron", "coral", "teal", "teal", "saffron", "coral"] as const
---

<section id={id} class={cn("relative bg-mint py-16 md:py-20", className)}>
  {arrow && <SectionArrow color={arrow} />}
  <div class="mx-auto max-w-6xl px-8 xl:px-0">
    <SectionHeader eyebrow={services.eyebrow} title={services.title} />
    <ul class="reveal-stagger-3 mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.items.map((item, index) => (
        <li class="motion-safe:scroll-triggered:reveal">
          <ServiceCard tone={tones[index]} title={item.title}>
            {item.body}
          </ServiceCard>
        </li>
      ))}
    </ul>
  </div>
</section>
