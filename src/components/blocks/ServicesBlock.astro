---
import SectionArrow from "@/components/atoms/SectionArrow.astro"
import SectionHeader from "@/components/molecules/SectionHeader.astro"
import ServiceCard from "@/components/molecules/ServiceCard.astro"
import Slider from "@/components/molecules/Slider.astro"
import { cn } from "@/libs/utils"
import type { Locale } from "@/i18n"
import {
  blockBackground,
  type BlockProps,
  type ServicesBlockCopy,
} from "@/libs/blocks"

type Props = ServicesBlockCopy &
  BlockProps & {
    locale: Locale
  }

const { id, arrow, locale, class: className, ...services } = Astro.props

/** The fill rotates per card, as the design has it. */
const tones = ["saffron", "coral", "teal", "teal", "saffron", "coral"] as const

const titleId = `${id ?? "services"}-title`

// By rows, so with six cards the two teal ones never touch.
const columns = Math.ceil(services.items.length / 2)

// Whole class strings, so Tailwind sees them.
const tracks: Record<number, string> = {
  1: "slider:grid-cols-[repeat(1,var(--slide))]",
  2: "slider:grid-cols-[repeat(2,var(--slide))]",
  3: "slider:grid-cols-[repeat(3,var(--slide))]",
}
---

<section
  id={id}
  class={cn("relative py-16 md:py-20", blockBackground("services"), className)}
>
  {arrow && <SectionArrow color={arrow} />}
  <div class="mx-auto max-w-6xl px-8 xl:px-0">
    <SectionHeader
      eyebrow={services.eyebrow}
      title={services.title}
      titleId={titleId}
    />
    <Slider
      as="ul"
      labelledby={titleId}
      locale={locale}
      class="mt-12"
      trackClass={cn(
        "reveal-stagger-3 grid gap-6 md:grid-cols-2 lg:grid-cols-3",
        "slider:grid-flow-row",
        tracks[columns],
        columns > 1 && "slider:min-[620px]:slide-half"
      )}
    >
      {services.items.map((item, index) => (
        <li class="md:motion-safe:scroll-triggered:reveal">
          <ServiceCard tone={tones[index]} title={item.title}>
            {item.body}
          </ServiceCard>
        </li>
      ))}
    </Slider>
  </div>
</section>
