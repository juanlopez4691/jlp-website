---
import type { ComponentProps } from "astro/types"
import SectionArrow from "@/components/atoms/SectionArrow.astro"
import SectionHeader from "@/components/molecules/SectionHeader.astro"
import WorkCard from "@/components/molecules/WorkCard.astro"
import { cn } from "@/libs/utils"
import { useTranslations, type Locale } from "@/i18n"

interface Props {
  /** Language of the current page. */
  locale: Locale
  /** Color of the block above. Without it, the block has no arrow. */
  arrow?: ComponentProps<typeof SectionArrow>["color"]
  class?: string
}

const { locale, arrow, class: className } = Astro.props
const work = useTranslations(locale, "work")
---

<section
  id="work"
  class={cn("relative bg-teal py-16 text-mint md:py-20", className)}
>
  {arrow && <SectionArrow color={arrow} />}
  <div class="mx-auto max-w-6xl px-8 xl:px-0">
    <SectionHeader tone="on-dark" eyebrow={work.eyebrow} title={work.title} />
    <ul class="mt-12 grid gap-6 md:grid-cols-2">
      {work.items.map((item) => (
        <li>
          <WorkCard
            client={item.client}
            title={item.title}
            result={item.result}
            chips={item.chips}
          >
            {item.body}
          </WorkCard>
        </li>
      ))}
    </ul>
    <h3 class="mt-12 text-3xl leading-tight font-bold">{work.moreTitle}</h3>
    <ul class="mt-4 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {work.more.map((item) => (
        <li>
          <WorkCard
            client={item.client}
            title={item.title}
            chips={item.chips}
            outline
            heading="h4"
          >
            {item.body}
          </WorkCard>
        </li>
      ))}
    </ul>
  </div>
</section>
