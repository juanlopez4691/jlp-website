---
import type { ComponentProps } from "astro/types"
import SectionArrow from "@/components/atoms/SectionArrow.astro"
import SectionHeader from "@/components/molecules/SectionHeader.astro"
import WorkCard from "@/components/molecules/WorkCard.astro"
import WorkCardFeatured from "@/components/molecules/WorkCardFeatured.astro"
import { cn } from "@/libs/utils"
import type { WorkBlockCopy } from "@/libs/blocks"

type Props = WorkBlockCopy & {
  id?: string
  /** Color of the block above. Without it, the block has no arrow. */
  arrow?: ComponentProps<typeof SectionArrow>["color"]
  class?: string
}

const { id, arrow, class: className, ...work } = Astro.props
---

<section
  id={id}
  class={cn("relative bg-teal py-16 text-mint md:py-20", className)}
>
  {arrow && <SectionArrow color={arrow} />}
  <div class="mx-auto max-w-6xl px-8 xl:px-0">
    <SectionHeader tone="on-dark" eyebrow={work.eyebrow} title={work.title} />
    <ul class="mt-12 flex flex-col gap-6">
      {work.featured.map((item, index) => (
        <li class="overflow-hidden rounded-tr-[48px] rounded-bl-[48px] bg-mint motion-safe:scroll-triggered:reveal">
          <WorkCardFeatured
            client={item.client}
            result={item.result}
            title={item.title}
            chips={item.chips}
            color={item.color}
            layout={index % 2 === 0 ? "row" : "row-reversed"}
          >
            {item.body}
          </WorkCardFeatured>
        </li>
      ))}
    </ul>
    <ul class="reveal-stagger-2 mt-6 grid gap-6 md:grid-cols-2">
      {work.items.map((item) => (
        <li class="rounded-tr-[48px] rounded-bl-[48px] bg-mint p-8 motion-safe:scroll-triggered:reveal">
          <WorkCard
            client={item.client}
            title={item.title}
            result={item.result}
            chips={item.chips}
            type="primary"
          >
            {item.body}
          </WorkCard>
        </li>
      ))}
    </ul>
    <h3 class="mt-12 text-3xl leading-tight font-bold">{work.moreTitle}</h3>
    <ul class="reveal-stagger-3 mt-4 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {work.more.map((item) => (
        <li class="rounded-tr-[48px] rounded-bl-[48px] border-[1.5px] border-mint p-8 motion-safe:scroll-triggered:reveal">
          <WorkCard
            client={item.client}
            title={item.title}
            chips={item.chips}
            type="secondary"
            heading="h4"
          >
            {item.body}
          </WorkCard>
        </li>
      ))}
    </ul>
  </div>
</section>
