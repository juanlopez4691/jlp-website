---
import { cn } from "@/libs/utils"

interface Props {
  /** The big number, such as `25+`. */
  number: string
  /** The line below the number, such as `years of experience`. */
  label: string
  class?: string
}

const { number, label, class: className } = Astro.props
---

<p class={cn("flex flex-col gap-2", className)}>
  <span class="font-display text-7xl leading-[0.8] font-bold tracking-tight text-saffron">
    {number}
  </span>
  <span class="text-lg leading-snug text-mint">{label}</span>
</p>
