---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
import IconExternalLink from "@/components/atoms/IconExternalLink.astro"
import { cn } from "@/libs/utils"
import { useTranslations, type Locale } from "@/i18n"

interface Props {
  /** The `Style` variant: the big quote that sits in the navy card. */
  featured?: boolean
  /** The paragraphs of the quote. */
  quote: string[]
  /** Language of the current page. */
  locale: Locale
  /** Name of the person. */
  name: string
  /** Their role and company. */
  role: string
  /** Their LinkedIn profile. */
  href: string
  /** Their photo; hidden below lg. Without it, no photo. */
  photo?: ImageMetadata
  /** The visually hidden note after each external link. */
  newTab: string
  class?: string
}

const {
  featured = false,
  quote,
  locale,
  name,
  role,
  href,
  photo,
  newTab,
  class: className,
} = Astro.props

const copy = useTranslations(locale, "quote")
const collapsible = !featured && quote.length > 1
---

<figure class={cn("flex h-full flex-col justify-between gap-8", className)}>
  <div>
    <blockquote
      class={cn(
        "space-y-4",
        featured
          ? "text-2xl leading-snug tracking-tight md:text-3xl xl:text-4xl"
          : "text-lg leading-normal slider:has-[+[aria-expanded=false]]:*:not-first:hidden slider:has-[+[aria-expanded=false]]:*:first:mb-0"
      )}
    >
      {quote.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </blockquote>
    {collapsible && (
      <button
        type="button"
        data-quote-toggle
        class="group/toggle mt-2 hidden cursor-pointer py-1 text-base leading-normal font-medium underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current slider:aria-[expanded]:block"
      >
        <span class="group-aria-expanded/toggle:hidden">{copy.more}</span>
        <span class="hidden group-aria-expanded/toggle:inline">
          {copy.less}
        </span>
        <span class="sr-only">: {name}</span>
      </button>
    )}
  </div>
  <figcaption class="flex items-center gap-2">
    {photo && (
      <Image
        src={photo}
        alt=""
        width={50}
        height={50}
        densities={[1, 2]}
        class="size-12.5 rounded-full lg:block"
      />
    )}
    <div class="flex flex-col gap-0.5">
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class="text-lg leading-tight font-semibold hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
      >
        {name}
        <span class="sr-only">{newTab}</span>
        <IconExternalLink class="ml-2" />
      </a>
      <p class="text-sm leading-tight">{role}</p>
    </div>
  </figcaption>
</figure>

<script>
  /*
   * Collapsing is opt-in: without `aria-expanded` nothing hides and no toggle
   * shows, so the full text stays with JavaScript off or a blocked script.
   */
  for (const toggle of document.querySelectorAll("[data-quote-toggle]")) {
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true"
      toggle.setAttribute("aria-expanded", `${!open}`)
    })
    toggle.setAttribute("aria-expanded", "false")
  }
</script>
