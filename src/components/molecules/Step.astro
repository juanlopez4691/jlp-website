---
import { cn } from "@/libs/utils"

interface Props {
  /** The step, with its number, such as "1. Listen and learn". */
  title: string
  class?: string
}

const { title, class: className } = Astro.props
---

<div class={cn("flex flex-col gap-3 border-t-2 border-ink pt-3", className)}>
  <h3 class="text-2xl leading-tight font-bold">{title}</h3>
  <p class="text-base leading-relaxed">
    <slot />
  </p>
</div>
