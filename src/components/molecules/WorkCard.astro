---
import Pill from "@/components/atoms/Pill.astro"
import { cn } from "@/libs/utils"

interface Props {
  /** The client name, plain uppercase text. */
  client: string
  /** The project, one line or two. */
  title: string
  /** The result headline under the client. Primary cards only. */
  result?: string
  /** Technologies, up to four. */
  chips: string[]
  /** `primary` is ink text on a mint card; `secondary` is mint text on an outline card. */
  type?: "primary" | "secondary"
  /** The title element. Secondary cards sit under the "More work" `h3`. */
  heading?: "h3" | "h4"
  class?: string
}

const {
  client,
  title,
  result,
  chips,
  type = "primary",
  heading = "h3",
  class: className,
} = Astro.props

const Heading = heading
---

<article
  class={cn(
    "flex h-full flex-col gap-4",
    type === "secondary" ? "text-mint" : "text-ink",
    className
  )}
>
  {type === "primary" ? (
    <>
      <div class="flex flex-col gap-2">
        <p class="text-sm leading-normal font-semibold tracking-tag uppercase">
          {client}
        </p>
        {result && (
          <p class="font-display text-3xl leading-[1.1] font-bold tracking-tight">
            {result}
          </p>
        )}
      </div>
      <Heading class="text-xl leading-tight font-bold">{title}</Heading>
    </>
  ) : (
    <div class="flex flex-col gap-1">
      <p class="text-sm leading-normal font-semibold tracking-tag uppercase">
        {client}
      </p>
      <Heading class="text-2xl leading-tight font-bold">{title}</Heading>
    </div>
  )}
  <p class="flex-1 text-lg leading-relaxed">
    <slot />
  </p>
  {chips.length > 0 && (
    <ul class={cn("flex flex-wrap gap-2", type === "secondary" && "pt-2")}>
      {chips.map((chip) => (
        <li>
          <Pill
            kind="chip"
            tone={type === "secondary" ? "on-dark" : "on-light"}
          >
            {chip}
          </Pill>
        </li>
      ))}
    </ul>
  )}
</article>
