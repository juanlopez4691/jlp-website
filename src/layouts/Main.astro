---
import "@/styles/global.css"
import Footer from "@/components/blocks/Footer.astro"
import Header from "@/components/blocks/Header.astro"
import type { Locale, Translations } from "@/i18n"

interface Props {
  title: string
  /** Language of the page, set on the `<html>` element. */
  locale: Locale
  /** The URL of this page in each language that has it. */
  translations?: Translations
}

const { title, locale, translations } = Astro.props

// `translations` includes the page itself, so a page with no translation has one entry.
const alternates = Object.entries(translations ?? {}).map(([code, path]) => ({
  code,
  href: new URL(path, Astro.site).href,
}))

// `translations` holds the URL of this page as it is served. A page with none,
// such as the 404, has no canonical.
const canonical = alternates.find(({ code }) => code === locale)?.href
---

<!doctype html>
<html lang={locale} class="has-[dialog[open]]:overflow-hidden">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.length > 1 &&
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.code} href={alternate.href} />
      ))}
    <slot name="head" />
  </head>
  <body class="flex min-h-svh flex-col">
    <Header locale={locale} translations={translations} />
    <slot />
    <Footer locale={locale} />
  </body>
</html>
