---
import type { InferGetStaticPropsType } from "astro"
import { getCollection, render } from "astro:content"
import Main from "@/layouts/Main.astro"
import Content from "@/components/blocks/Content.astro"
import { getTranslations } from "@/libs/translations"
import { isLocale, useTranslations } from "@/i18n"

export async function getStaticPaths() {
  const pages = await getCollection("pages")

  return pages.map((page) => {
    const [lang, slug] = page.id.split("/")

    if (!isLocale(lang)) {
      throw new Error(`Unsupported language "${lang}" in ${page.filePath}`)
    }

    return {
      params: { lang, slug },
      props: { lang, page },
    }
  })
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { lang, page } = Astro.props

/*
 * Computed here, not in getStaticPaths: it reads every language folder, and
 * there a page in an unknown folder would make Astro throw its vague
 * MissingLocale error before the "Unsupported language" check named the file.
 */
const translations = getTranslations(page, await getCollection("pages"))

const { title, description, updated, noindex } = page.data
const { Content: Body } = await render(page)
const contentPage = useTranslations(lang, "contentPage")
const date = new Intl.DateTimeFormat(lang, {
  dateStyle: "long",
  timeZone: "UTC",
}).format(updated)
---

<Main
  title={`${title} | ${contentPage.siteName}`}
  description={description}
  locale={lang}
  translations={translations}
>
  {noindex && <meta slot="head" name="robots" content="noindex, nofollow" />}
  <main class="flex-1">
    <Content>
      <h1>{title}</h1>
      <p>
        <small>
          {contentPage.updated}{" "}
          <time datetime={updated.toISOString().slice(0, 10)}>{date}</time>
        </small>
      </p>
      <Body />
    </Content>
  </main>
</Main>
