---
import Main from "@/layouts/Main.astro"
import HeroBlock from "@/components/blocks/HeroBlock.astro"
import FactsBlock from "@/components/blocks/FactsBlock.astro"
import ServicesBlock from "@/components/blocks/ServicesBlock.astro"
import HowBlock from "@/components/blocks/HowBlock.astro"
import ExperienceBlock from "@/components/blocks/ExperienceBlock.astro"
import StackBlock from "@/components/blocks/StackBlock.astro"
import ContactBlock from "@/components/blocks/ContactBlock.astro"
import QuoteBlock from "@/components/blocks/QuoteBlock.astro"
import WorkBlock from "@/components/blocks/WorkBlock.astro"
import RecommendationsBlock from "@/components/blocks/RecommendationsBlock.astro"
import { isLocale, locales, useTranslations, type Translations } from "@/i18n"
import { homeUrl } from "@/libs/translations"

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }))
}

const { lang } = Astro.params

if (!isLocale(lang)) {
  throw new Error(`Unsupported language: ${lang}`)
}

const homePage = useTranslations(lang, "homePage")

const translations: Translations = Object.fromEntries(
  locales.map((code) => [code, homeUrl(code)])
)
---

<Main title={homePage.title} locale={lang} translations={translations}>
  <link
    slot="head"
    rel="alternate"
    hreflang="x-default"
    href={new URL("/", Astro.site).href}
  />
  <main class="flex-1">
    <HeroBlock locale={lang} />
    <FactsBlock locale={lang} />
    <ServicesBlock locale={lang} arrow="navy" />
    <QuoteBlock locale={lang} arrow="mint" />
    <WorkBlock locale={lang} arrow="coral" />
    <RecommendationsBlock locale={lang} arrow="teal" />
    <HowBlock locale={lang} arrow="saffron" />
    <ExperienceBlock locale={lang} arrow="coral" />
    <StackBlock locale={lang} arrow="mint" />
    <ContactBlock locale={lang} arrow="navy" />
  </main>
</Main>
