---
import Main from "@/layouts/Main.astro"
import HeroBlock from "@/components/blocks/HeroBlock.astro"
import FactsBlock from "@/components/blocks/FactsBlock.astro"
import ServicesBlock from "@/components/blocks/ServicesBlock.astro"
import HowBlock from "@/components/blocks/HowBlock.astro"
import ExperienceBlock from "@/components/blocks/ExperienceBlock.astro"
import StackBlock from "@/components/blocks/StackBlock.astro"
import ContactBlock from "@/components/blocks/ContactBlock.astro"
import QuoteBlock from "@/components/blocks/QuoteBlock.astro"
import WorkBlock from "@/components/blocks/WorkBlock.astro"
import RecommendationsBlock from "@/components/blocks/RecommendationsBlock.astro"
import { getRelativeLocaleUrl } from "astro:i18n"
import { isLocale, locales, type Translations } from "@/i18n"
import { getHomePage } from "@/libs/home"

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }))
}

const { lang } = Astro.params

if (!isLocale(lang)) {
  throw new Error(`Unsupported language: ${lang}`)
}

const { title, description, blocks } = await getHomePage(lang)

const translations: Translations = Object.fromEntries(
  locales.map((code) => [code, getRelativeLocaleUrl(code)])
)
---

<Main
  title={title}
  description={description}
  locale={lang}
  translations={translations}
>
  <link
    slot="head"
    rel="alternate"
    hreflang="x-default"
    href={new URL("/", Astro.site).href}
  />
  <main class="flex-1">
    {blocks.map((block) => {
      switch (block.type) {
        case "hero":
          return <HeroBlock locale={lang} id={block.id} {...block.props} />
        case "facts":
          return <FactsBlock id={block.id} {...block.props} />
        case "services":
          return (
            <ServicesBlock id={block.id} arrow={block.arrow} {...block.props} />
          )
        case "quote":
          return (
            <QuoteBlock id={block.id} arrow={block.arrow} {...block.props} />
          )
        case "work":
          return (
            <WorkBlock id={block.id} arrow={block.arrow} {...block.props} />
          )
        case "recommendations":
          return (
            <RecommendationsBlock
              locale={lang}
              id={block.id}
              arrow={block.arrow}
              {...block.props}
            />
          )
        case "how":
          return <HowBlock id={block.id} arrow={block.arrow} {...block.props} />
        case "experience":
          return (
            <ExperienceBlock
              id={block.id}
              arrow={block.arrow}
              {...block.props}
            />
          )
        case "stack":
          return (
            <StackBlock id={block.id} arrow={block.arrow} {...block.props} />
          )
        case "contact":
          return (
            <ContactBlock
              locale={lang}
              id={block.id}
              arrow={block.arrow}
              {...block.props}
            />
          )
        default: {
          const _exhaustive: never = block
          return _exhaustive
        }
      }
    })}
  </main>
</Main>
