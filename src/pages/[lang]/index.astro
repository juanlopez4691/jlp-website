---
import Main from "@/layouts/Main.astro"
import HeroBlock from "@/components/blocks/HeroBlock.astro"
import FactsBlock from "@/components/blocks/FactsBlock.astro"
import ServicesBlock from "@/components/blocks/ServicesBlock.astro"
import HowBlock from "@/components/blocks/HowBlock.astro"
import ExperienceBlock from "@/components/blocks/ExperienceBlock.astro"
import StackBlock from "@/components/blocks/StackBlock.astro"
import ContactBlock from "@/components/blocks/ContactBlock.astro"
import QuoteBlock from "@/components/blocks/QuoteBlock.astro"
import WorkBlock from "@/components/blocks/WorkBlock.astro"
import RecommendationsBlock from "@/components/blocks/RecommendationsBlock.astro"
import { getRelativeLocaleUrl } from "astro:i18n"
import { isLocale, locales, type Translations } from "@/i18n"
import { getHomePage } from "@/libs/home"

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }))
}

const { lang } = Astro.params

if (!isLocale(lang)) {
  throw new Error(`Unsupported language: ${lang}`)
}

// The entry holds every block's whole copy; the i18n default it overrides is
// dead until #114.
const { title, description, blocks } = await getHomePage(lang)

const translations: Translations = Object.fromEntries(
  locales.map((code) => [code, getRelativeLocaleUrl(code)])
)
---

<Main
  title={title}
  description={description}
  locale={lang}
  translations={translations}
>
  <link
    slot="head"
    rel="alternate"
    hreflang="x-default"
    href={new URL("/", Astro.site).href}
  />
  <main class="flex-1">
    {blocks.map((block) => {
      switch (block.type) {
        case "hero":
          return <HeroBlock locale={lang} />
        case "facts":
          return <FactsBlock locale={lang} />
        case "services":
          return <ServicesBlock locale={lang} arrow={block.arrow} />
        case "quote":
          return <QuoteBlock locale={lang} arrow={block.arrow} />
        case "work":
          return <WorkBlock locale={lang} arrow={block.arrow} />
        case "recommendations":
          return <RecommendationsBlock locale={lang} arrow={block.arrow} />
        case "how":
          return <HowBlock locale={lang} arrow={block.arrow} />
        case "experience":
          return <ExperienceBlock locale={lang} arrow={block.arrow} />
        case "stack":
          return <StackBlock locale={lang} arrow={block.arrow} />
        case "contact":
          return <ContactBlock locale={lang} arrow={block.arrow} />
        default: {
          const _exhaustive: never = block
          return _exhaustive
        }
      }
    })}
  </main>
</Main>
