---
import { getRelativeLocaleUrl } from "astro:i18n"
import { defaultLocale } from "@/i18n"

// The site root has no content of its own: it sends visitors to the default
// language. Only a fallback for `bun run dev`, where no Worker runs; deployed,
// `src/worker.ts` answers `/` with the language of the browser.
return Astro.redirect(getRelativeLocaleUrl(defaultLocale))
---
