{
  "name": "lojopez",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/"],
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "lojopez.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
